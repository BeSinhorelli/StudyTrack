// ─────────────────────────────────────────────────────
// StudyTrack — Prisma Schema
// ─────────────────────────────────────────────────────
//
// Notas importantes:
// 1. SQLite NÃO suporta ENUM nativo → usamos String + validação via Zod.
//    Topic.status  → "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"
//    Task.status   → "TODO" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
//    Task.priority → "LOW" | "MEDIUM" | "HIGH"
//
// 2. binaryTargets:
//    - "native"                    → Windows/macOS/Linux local
//    - "linux-musl-openssl-3.0.x"  → Docker Alpine + OpenSSL 3.x
//
// 3. Migração futura para Postgres:
//    - Trocar `provider = "sqlite"` por `"postgresql"`
//    - Trocar `DATABASE_URL` no .env
//    - Rodar `npx prisma migrate dev --name migrate_to_postgres`
//    - Opcional: reativar enums (remover comentários dos blocos enum abaixo)
// ─────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────
// Enums (comentados — SQLite não suporta)
// Quando migrar para Postgres, descomente e troque
// os campos String por estes tipos.
// ─────────────────────────────────────────────────────
//
// enum TopicStatus {
//   NOT_STARTED
//   IN_PROGRESS
//   COMPLETED
// }
//
// enum TaskStatus {
//   TODO
//   IN_PROGRESS
//   COMPLETED
//   CANCELLED
// }
//
// enum TaskPriority {
//   LOW
//   MEDIUM
//   HIGH
// }

// ─────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subjects      Subject[]
  tasks         Task[]
  studySessions StudySession[]
  goals         Goal[]
  notes         Note[]
  studyPlans    StudyPlan[]

  @@map("users")
}

// ─────────────────────────────────────────────────────
// Subject — matéria/área de estudo
// ─────────────────────────────────────────────────────
model Subject {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics        Topic[]
  tasks         Task[]
  studySessions StudySession[]
  goals         Goal[]
  notes         Note[]

  @@unique([userId, name])
  @@index([userId])
  @@map("subjects")
}

// ─────────────────────────────────────────────────────
// Topic — tópico dentro de uma matéria
// ─────────────────────────────────────────────────────
model Topic {
  id          String   @id @default(cuid())
  subjectId   String   @map("subject_id")
  name        String
  description String?
  status      String   @default("NOT_STARTED")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  studySessions StudySession[]
  notes         Note[]

  @@unique([subjectId, name])
  @@index([subjectId])
  @@index([subjectId, status])
  @@map("topics")
}

// ─────────────────────────────────────────────────────
// Task — tarefa
// ─────────────────────────────────────────────────────
model Task {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  subjectId   String?   @map("subject_id")
  title       String
  description String?
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  dueDate     DateTime? @map("due_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([userId, createdAt])
  @@map("tasks")
}

// ─────────────────────────────────────────────────────
// StudySession — sessão real de estudo
// ─────────────────────────────────────────────────────
model StudySession {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  subjectId       String   @map("subject_id")
  topicId         String?  @map("topic_id")
  startedAt       DateTime @map("started_at")
  endedAt         DateTime @map("ended_at")
  durationMinutes Int      @map("duration_minutes")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, subjectId])
  @@index([subjectId, startedAt])
  @@index([topicId])
  @@map("study_sessions")
}

// ─────────────────────────────────────────────────────
// Goal — meta com progresso calculado
// ─────────────────────────────────────────────────────
model Goal {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  subjectId   String?  @map("subject_id")
  title       String
  targetHours Float    @map("target_hours")
  deadline    DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  // Nota: current_hours NÃO existe — é calculado a partir das study_sessions

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, deadline])
  @@index([userId, createdAt])
  @@map("goals")
}

// ─────────────────────────────────────────────────────
// Note — anotação
// ─────────────────────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subjectId String?  @map("subject_id")
  topicId   String?  @map("topic_id")
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, subjectId])
  @@index([userId, topicId])
  @@map("notes")
}

// ─────────────────────────────────────────────────────
// StudyPlan — plano de estudo por período
// ─────────────────────────────────────────────────────
model StudyPlan {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  title       String
  description String?
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startDate])
  @@map("study_plans")
}