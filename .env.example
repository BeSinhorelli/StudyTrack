# ─────────────────────────────────────────────
# Docker Compose — variáveis compartilhadas
# ─────────────────────────────────────────────

# Backend (usado pelo container backend)
JWT_SECRET=change-me-em-producao-use-uma-string-aleatoria-de-32-caracteres
JWT_EXPIRES_IN=7d
PORT=3000

# CORS (só usado se NODE_ENV != development)
CORS_ORIGIN=http://localhost

# Database (SQLite atual)
DATABASE_URL=file:./dev.db